<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="700.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.triviafx.TriviaController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lbPuntaje" text="Puntaje: 0" />
            <ProgressBar fx:id="pbProgreso" maxWidth="1.7976931348623157E308" progress="0.0" HBox.hgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <ImageView fx:id="imgPregunta" fitHeight="200.0" fitWidth="400.0" pickOnBounds="true" preserveRatio="true" />
            <TextField fx:id="lbPregunta" editable="false" />
         </children>
      </VBox>
   </center>
   <bottom>
      <VBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <RadioButton fx:id="rbUno" mnemonicParsing="false" text="RadioButton">
               <toggleGroup>
                  <ToggleGroup fx:id="opciones" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbDos" mnemonicParsing="false" text="RadioButton" toggleGroup="$opciones" />
            <RadioButton fx:id="rbTres" mnemonicParsing="false" text="RadioButton" toggleGroup="$opciones" />
            <RadioButton fx:id="rbCuatro" mnemonicParsing="false" text="RadioButton" toggleGroup="$opciones" />
            <Button fx:id="btnSiguiente" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onActionSiguiente" text="Siguiente" />
            <TextField fx:id="tfRetroalimentacion" editable="false" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </bottom>
</BorderPane>
